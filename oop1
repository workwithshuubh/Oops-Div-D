#include <iostream>
#include <string>
using namespace std;

int main()
{
    // Variables and data types
    string name;
    int age;
    float marks;
    double num1, num2;

    // Constant
    const float PI = 3.14;

    // Taking input
    cout << "Enter your name: ";
    getline(cin, name);

    cout << "Enter your age: ";
    cin >> age;

    cout << "Enter your marks: ";
    cin >> marks;

    cout << "Enter first number: ";
    cin >> num1;

    cout << "Enter second number: ";
    cin >> num2;

    // Displaying information
    cout << "\n----- Student Details -----" << endl;
    cout << "Name: " << name << endl;
    cout << "Age: " << age << endl;
    cout << "Marks: " << marks << endl;
    cout << "Constant PI: " << PI << endl;

    // Arithmetic operators
    cout << "\n----- Arithmetic Operations -----" << endl;
    cout << "Addition: " << num1 + num2 << endl;
    cout << "Subtraction: " << num1 - num2 << endl;
    cout << "Multiplication: " << num1 * num2 << endl;

    if (num2 != 0)
        cout << "Division: " << num1 / num2 << endl;
    else
        cout << "Division: Not possible (divide by zero)" << endl;

    // Relational operators
    cout << "\n----- Relational Operations -----" << endl;
    cout << "First number is greater: " << (num1 > num2) << endl;
    cout << "Numbers are equal: " << (num1 == num2) << endl;
    cout << "First number is smaller: " << (num1 < num2) << endl;

    // Logical operators
    cout << "\n----- Logical Operations -----" << endl;
    cout << "Both numbers are positive: "
         << (num1 > 0 && num2 > 0) << endl;

    cout << "At least one number is positive: "
         << (num1 > 0 || num2 > 0) << endl;

    cout << "First number is not zero: "
         << !(num1 == 0) << endl;

    return 0;
}
